<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<connectionStrings>
 
        <add name="WONG_BANKING.Properties.Settings.BankDBConnectionString"
            connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=BankDB;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;"
            providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>